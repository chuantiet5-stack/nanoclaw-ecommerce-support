# .env.example — 环境变量模板（生产落地 P0-1.2 步骤 1）
# 复制为 .env 并填入真实值；.env 已加入 .gitignore，绝不提交到 Git

# LLM
NANOCLAW_API_KEY=sk-your-real-key
NANOCLAW_BASE_URL=https://api.siliconflow.cn/v1
NANOCLAW_MODEL=zai-org/GLM-5.3

# 数据库（P0-1.1 数据层，配合 db/ 模块）
DB_URL=mysql+aiomysql://ecom_user:strong_password@localhost:3306/ecom_db
REDIS_URL=redis://localhost:6379/0

# MySQL Docker 初始化（docker-compose.yml 使用）
MYSQL_ROOT_PASSWORD=change-me-root
DB_PASSWORD=change-me-ecom

# 飞书
FEISHU_APP_ID=cli_xxx
FEISHU_APP_SECRET=xxx

# QQ
QQ_APP_ID=123456
QQ_APP_SECRET=xxx

# JWT 密钥（生产环境用 python -c "import secrets; print(secrets.token_hex(32))" 生成）
JWT_SECRET=your-256-bit-secret-here
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# Web
WEB_HOST=0.0.0.0
WEB_PORT=8080

# CORS 允许来源（逗号分隔，生产环境填具体域名，不要用 *）
CORS_ORIGINS=http://localhost:8080,http://localhost:8081

# ExecTool 开关（P0-1.2：生产环境设为 false 禁用 Shell 工具）
ENABLE_SHELL_TOOL=true

# LLM 超时与重试（P1-2.2，秒）
LLM_REQUEST_TIMEOUT=120

# LLM 全局限流（P1-2.2：每秒请求数 / 突发容量）
LLM_RATE_QPS=10
LLM_RATE_BURST=20

# 单条消息处理超时（P0-1.3，秒）
AGENT_TASK_TIMEOUT=300

# 日志（P1-2.3）
LOG_DIR=logs
LOG_LEVEL=INFO
